{
  "name": "zar-bot2",
  "version": "1.0.0",
  "description": "ربات زرکوین (بات زر) روی Cloudflare Workers — D1 + KV + Webhook",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute zar-bot --remote --file=migrations/0001_init.sql",
    "db:init:local": "wrangler d1 execute zar-bot --local --file=migrations/0001_init.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^3.99.0"
  }
}
